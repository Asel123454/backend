# Postgres connection string from Neon (https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port (Render sets this automatically)
PORT=4000

# Frontend URL (Vercel), e.g. https://your-app.vercel.app
FRONTEND_URL="http://localhost:3000"

UPLOAD_DIR="./uploads"

# Cloudinary — для постоянного хранения загруженных картинок.
# Возьми готовую строку в дашборде Cloudinary (Dashboard → API Environment variable).
# Если не задано — загрузка падает на локальный диск (./uploads).
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
